# ============================================================
# VARIABLES DE ENTORNO — n8n Automation Suite
# Copia este archivo como .env y completa los valores
# ============================================================

# ─── n8n ──────────────────────────────────────────────────
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_ENCRYPTION_KEY=cambio-me-por-una-clave-segura-de-32-caracteres

# ─── Base de datos local de n8n (PostgreSQL) ──────────────
DB_POSTGRESDB_PASSWORD=cambia-esta-contraseña

# ─── pgAdmin (opcional) ──────────────────────────────────
PGADMIN_EMAIL=admin@iducdev.com
PGADMIN_PASSWORD=admin123

# ─── Supabase (base de datos de los workflows) ────────────
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...  # Service Role Key
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...    # Anon Key (pública)

# PostgreSQL directo a Supabase (para el nodo PostgreSQL en n8n)
SUPABASE_DB_HOST=db.tu-proyecto.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=tu-contraseña-de-supabase

# ─── APIs de IA ──────────────────────────────────────────
# Al menos una de las dos:

# OpenAI
OPENAI_API_KEY=sk-proj-tu-api-key-de-openai
OPENAI_MODEL=gpt-4  # o gpt-4o-mini para ahorrar costes

# Anthropic (alternativa)
ANTHROPIC_API_KEY=sk-ant-tu-api-key-de-anthropic
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Ollama (IA local gratuita — solo self-hosted)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ─── Notificaciones ──────────────────────────────────────

# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_CHAT_ID=123456789  # Tu chat ID personal

# WhatsApp Business API (Twilio)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_NUMBER=+14155238886  # Número de Twilio
MY_WHATSAPP_NUMBER=+584241234567      # Tu número personal

# ─── Outreach (Email) ────────────────────────────────────

# Gmail SMTP (usa App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=iducdev.inc@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx  # App Password de Google
SMTP_SENDER_NAME=Isaac Urdaneta | IDUCDEV

# ─── LinkedIn (si aplica) ────────────────────────────────
LINKEDIN_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxx
LINKEDIN_CLIENT_ID=xxxxxxxxxxxxxx
LINKEDIN_CLIENT_SECRET=xxxxxxxxxxxxxx

# ─── Job Sources - APIs externas ─────────────────────────
# (opcionales, según fuentes que implementes)

#Indeed Publisher API
INDEED_PUBLISHER_ID=xxxxxxxxxxxx

#Upwork (si usas API oficial)
UPWORK_API_KEY=xxxxxxxxxxxx
